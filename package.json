{
  "name": "@hujiale2609/ai-harness",
  "version": "1.2.1",
  "description": "Repository-level AI development harness CLI",
  "bin": {
    "AIharness": "dist/cli.js",
    "aiharness": "dist/cli.js",
    "ai-harness": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "templates",
    "schemas",
    ".agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "dev": "tsx src/cli.ts",
    "release": "pnpm build && changeset publish",
    "test": "vitest run test",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "dependencies": {
    "commander": "^15.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
